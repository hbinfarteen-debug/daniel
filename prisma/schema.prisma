generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:../db/custom.db"
}

model ContactEnquiry {
  id        String   @id @default(uuid())
  name      String
  phone     String
  email     String
  service   String
  message   String
  createdAt DateTime @default(now())
}
